# CSV público de Google Sheets (Archivo > Compartir > Publicar en la web, formato CSV)
SHEETS_CSV_URL=

# Service Account de Google (servidor únicamente, nunca en el navegador)
# Opción recomendada: el archivo .json completo de la Service Account,
# codificado en base64 en una sola línea (evita que pegar la clave PEM
# se rompa por saltos de línea o autocorrección, sobre todo desde celular).
#   Mac/Linux: base64 -i service-account.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Alternativa (si no usás la variable de arriba): email + clave PEM por separado.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

GOOGLE_SHEET_ID=

# Cloudinary (públicos, no son secretos)
PUBLIC_CLOUDINARY_CLOUD_NAME=srxrmckc
PUBLIC_CLOUDINARY_UPLOAD_PRESET=mute-products
