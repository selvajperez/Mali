---
import ProductCard from "../components/ProductCard.astro";
import CartDrawer from "../components/CartDrawer.astro";
import PaymentMethodsModal from "../components/PaymentMethodsModal.astro";
import { getCatalogProducts } from "../lib/sheets";
import { CATEGORIES } from "../lib/categories";
import {
  STORE_NAME,
  BRAND_COLOR,
  BRAND_COLOR_DARK,
  STORE_LOGO_URL,
  PARENT_BRAND_MARK_URL,
  INSTAGRAM_URL,
  FACEBOOK_URL,
  PAYMENT_METHODS,
  EMPTY_CATALOG_TEXT,
  NO_RESULTS_TEXT,
  FONT_HEADING,
  FONT_BODY,
  BACKGROUND_COLOR,
  GOOGLE_FONTS_URL,
  ACCENT_COLOR,
  SURFACE_COLOR,
  SECONDARY_TEXT_COLOR,
  TEXT_COLOR,
} from "../lib/storeConfig";

let products: Awaited<ReturnType<typeof getCatalogProducts>> = [];
let error: string | null = null;

try {
  products = await getCatalogProducts();
} catch (e) {
  error = e instanceof Error ? e.message : "Error desconocido";
}

const categoriasPresentes = CATEGORIES.filter((cat) =>
  products.some((p) => p.categoria === cat)
);

const hayMediosDePago = PAYMENT_METHODS.some((m) => m.activo);
const hayLinksSociales = Boolean(INSTAGRAM_URL || FACEBOOK_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{STORE_NAME} - Catálogo</title>
    {GOOGLE_FONTS_URL && <link rel="stylesheet" href={GOOGLE_FONTS_URL} />}
  </head>
  <body>
    <header class="header">
      <div class="header-top">
        {STORE_LOGO_URL ? (
          <img src={STORE_LOGO_URL} alt={STORE_NAME} class="logo-img" />
        ) : (
          <span class="logo">
            {PARENT_BRAND_MARK_URL && (
              <img src={PARENT_BRAND_MARK_URL} alt="" class="logo-mark" />
            )}
            {STORE_NAME}
          </span>
        )}
        <button type="button" id="btn-carrito" class="btn-carrito" aria-label="Ver carrito">
          🛒
          <span id="cart-badge" class="badge-carrito">0</span>
        </button>
      </div>
      <input
        type="search"
        id="buscador"
        class="buscador"
        placeholder="Buscar productos..."
        aria-label="Buscar productos"
      />
    </header>

    <CartDrawer />

    {!error && categoriasPresentes.length > 0 && (
      <nav class="categorias" aria-label="Filtrar por categoría">
        <button type="button" class="chip chip-activo" data-categoria="Todos">Todos</button>
        {categoriasPresentes.map((cat) => (
          <button type="button" class="chip" data-categoria={cat}>{cat}</button>
        ))}
      </nav>
    )}

    <main>
      {error && <p class="error">El catálogo estará disponible pronto.</p>}
      {!error && products.length === 0 && <p class="vacio">{EMPTY_CATALOG_TEXT}</p>}
      {!error && products.length > 0 && (
        <div class="grid" id="grid-productos">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      )}
      <p class="vacio" id="sin-resultados" hidden>{NO_RESULTS_TEXT}</p>
    </main>

    {(hayLinksSociales || hayMediosDePago) && (
      <footer class="footer">
        {hayLinksSociales && (
          <div class="footer-social">
            {INSTAGRAM_URL && (
              <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="footer-link">
                Instagram
              </a>
            )}
            {FACEBOOK_URL && (
              <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" class="footer-link">
                Facebook
              </a>
            )}
          </div>
        )}
        {hayMediosDePago && (
          <button type="button" id="btn-medios-pago" class="footer-link footer-btn">
            Medios de pago
          </button>
        )}
      </footer>
    )}

    <PaymentMethodsModal medios={PAYMENT_METHODS} />

    <style
      define:vars={{
        brandColor: BRAND_COLOR,
        brandColorDark: BRAND_COLOR_DARK,
        fontHeading: FONT_HEADING,
        fontBody: FONT_BODY,
        backgroundColor: BACKGROUND_COLOR,
        accentColor: ACCENT_COLOR,
        surfaceColor: SURFACE_COLOR,
        secondaryTextColor: SECONDARY_TEXT_COLOR,
        textColor: TEXT_COLOR,
      }}
    >
      * {
        box-sizing: border-box;
      }
      :root {
        --brand-color: var(--brandColor);
        --font-heading: var(--fontHeading);
        --accent-color: var(--accentColor);
        --surface-color: var(--surfaceColor);
        --secondary-text-color: var(--secondaryTextColor);
      }
      body {
        margin: 0;
        font-family: var(--fontBody);
        background: var(--backgroundColor);
        color: var(--textColor);
      }
      .header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--backgroundColor);
        border-bottom: 1px solid color-mix(in srgb, var(--brandColor) 28%, transparent);
        padding: 1.1rem 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }
      .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--fontHeading);
        font-size: 2rem;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--brandColor);
      }
      .logo-img {
        max-height: 3.2rem;
        max-width: 62vw;
        display: block;
      }
      .logo-mark {
        height: 1.5rem;
        width: auto;
        display: block;
        flex-shrink: 0;
      }
      .btn-carrito {
        position: relative;
        border: 1px solid color-mix(in srgb, var(--brandColor) 42%, transparent);
        background: transparent;
        color: var(--textColor);
        border-radius: 999px;
        width: 2.5rem;
        height: 2.5rem;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .badge-carrito {
        position: absolute;
        top: -0.3rem;
        right: -0.3rem;
        background: var(--accentColor);
        color: var(--surfaceColor);
        font-size: 0.65rem;
        font-weight: 700;
        min-width: 1.1rem;
        height: 1.1rem;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.2rem;
      }
      .buscador {
        width: 100%;
        padding: 0.8rem 0;
        border-radius: 0;
        border: 0;
        border-bottom: 1px solid color-mix(in srgb, var(--brandColor) 35%, transparent);
        font-size: 0.95rem;
        background: transparent;
        color: var(--textColor);
      }
      .buscador::placeholder {
        color: var(--secondaryTextColor);
      }
      .buscador:focus {
        outline: none;
        border-bottom-color: var(--brandColor);
      }
      .categorias {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding: 0.65rem 1rem;
        background: var(--backgroundColor);
        border-bottom: 1px solid color-mix(in srgb, var(--brandColor) 22%, transparent);
        scrollbar-width: none;
      }
      .categorias::-webkit-scrollbar {
        display: none;
      }
      .chip {
        flex-shrink: 0;
        border: 1px solid color-mix(in srgb, var(--brandColor) 45%, transparent);
        background: transparent;
        color: var(--brandColor);
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0;
        white-space: nowrap;
      }
      .chip-activo {
        background: var(--brandColor);
        border-color: var(--brandColor);
        color: var(--surfaceColor);
      }
      main {
        padding: 1.5rem 1.25rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
      }
      .error {
        max-width: 24rem;
        margin: 2.5rem auto;
        color: var(--secondaryTextColor);
        text-align: center;
        line-height: 1.6;
      }
      .vacio {
        color: var(--secondaryTextColor);
        text-align: center;
        margin-top: 2rem;
      }
      .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 1.5rem 1rem 2rem;
        background: #000;
        color: #ccc;
      }
      .footer-social {
        display: flex;
        gap: 1rem;
      }
      .footer-link {
        border: none;
        background: none;
        font: inherit;
        color: #fff;
        text-decoration: underline;
        font-size: 0.85rem;
        padding: 0.25rem;
      }
      @media (min-width: 640px) {
        .grid {
          grid-template-columns: repeat(3, 1fr);
        }
        .header,
        main {
          padding-left: 2rem;
          padding-right: 2rem;
        }
      }
      @media (min-width: 960px) {
        .grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
    </style>

    <script>
      import {
        buildWhatsAppMessage,
        buildWhatsAppUrl,
        calcularTotalesPorMoneda,
        contarUnidades,
        formatMoney,
        type CartItem,
      } from "../lib/cart";
      import { isValidCurrency } from "../lib/currencies";
      import {
        WHATSAPP_PHONE,
        DEFAULT_CURRENCY,
        ORDER_GREETING,
        ORDER_CLOSING,
        DELIVERY_INFO,
        PICKUP_INFO,
      } from "../lib/storeConfig";

      const buscador = document.getElementById("buscador") as HTMLInputElement | null;
      const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
      const cards = document.querySelectorAll<HTMLElement>("#grid-productos .card");
      const sinResultados = document.getElementById("sin-resultados");

      let categoriaActiva = "Todos";

      function aplicarFiltros() {
        const texto = (buscador?.value ?? "").trim().toLowerCase();
        let visibles = 0;

        cards.forEach((card) => {
          const coincideTexto = card.dataset.nombre?.includes(texto) ?? true;
          const coincideCategoria = categoriaActiva === "Todos" || card.dataset.categoria === categoriaActiva;
          const mostrar = coincideTexto && coincideCategoria;
          card.style.display = mostrar ? "" : "none";
          if (mostrar) visibles++;
        });

        if (sinResultados) {
          sinResultados.hidden = visibles !== 0;
        }
      }

      buscador?.addEventListener("input", aplicarFiltros);

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          categoriaActiva = chip.dataset.categoria ?? "Todos";
          chips.forEach((c) => c.classList.toggle("chip-activo", c === chip));
          aplicarFiltros();
        });
      });

      // --- Carrito ---
      const CART_KEY = "mute_carrito";

      function cargarCarrito(): CartItem[] {
        try {
          const guardado = localStorage.getItem(CART_KEY);
          if (!guardado) return [];
          const datos = JSON.parse(guardado);
          if (!Array.isArray(datos)) return [];
          // Carritos guardados antes de sumar moneda no tienen ese campo.
          return datos.map((item) => ({
            ...item,
            moneda: isValidCurrency(item.moneda) ? item.moneda : DEFAULT_CURRENCY,
          }));
        } catch {
          return [];
        }
      }

      let carrito: CartItem[] = cargarCarrito();

      function guardarCarrito() {
        localStorage.setItem(CART_KEY, JSON.stringify(carrito));
      }

      const btnCarrito = document.getElementById("btn-carrito");
      const cartBadge = document.getElementById("cart-badge");
      const cartOverlay = document.getElementById("cart-overlay");
      const cartDrawer = document.getElementById("cart-drawer");
      const cartCerrar = document.getElementById("cart-cerrar");
      const cartItemsEl = document.getElementById("cart-items");
      const cartVacioEl = document.getElementById("cart-vacio");
      const cartTotales = document.getElementById("cart-totales");
      const cartWhatsapp = document.getElementById("cart-whatsapp") as HTMLButtonElement | null;
      const cartVaciar = document.getElementById("cart-vaciar") as HTMLButtonElement | null;

      function renderCarrito() {
        cartBadge && (cartBadge.textContent = String(contarUnidades(carrito)));
        if (cartVaciar) cartVaciar.hidden = carrito.length === 0;

        if (cartItemsEl) {
          cartItemsEl.innerHTML = carrito
            .map(
              (item) => `
                <li class="cart-item" data-id="${item.id}">
                  <img src="${item.fotoUrl}" alt="${item.nombre}" />
                  <div class="cart-item-info">
                    <p class="cart-item-nombre">${item.nombre}</p>
                    <p class="cart-item-precio">${formatMoney(item.precio, item.moneda)} c/u</p>
                    <div class="cart-item-cantidad">
                      <button type="button" class="btn-qty" data-accion="restar" aria-label="Restar unidad">−</button>
                      <span>${item.cantidad}</span>
                      <button type="button" class="btn-qty" data-accion="sumar" aria-label="Sumar unidad">+</button>
                      <button type="button" class="btn-eliminar" data-accion="eliminar" aria-label="Eliminar producto">Eliminar</button>
                    </div>
                  </div>
                  <p class="cart-item-subtotal">${formatMoney(item.precio * item.cantidad, item.moneda)}</p>
                </li>
              `
            )
            .join("");
        }

        if (cartVacioEl) cartVacioEl.hidden = carrito.length > 0;

        if (cartTotales) {
          const totales = calcularTotalesPorMoneda(carrito);
          cartTotales.innerHTML = totales.length
            ? totales
                .map(({ moneda, total }) => {
                  const etiqueta = totales.length > 1 ? `Total ${moneda}` : "Total";
                  return `<div class="cart-total-linea"><span>${etiqueta}</span><span>${formatMoney(total, moneda)}</span></div>`;
                })
                .join("")
            : `<div class="cart-total-linea"><span>Total</span><span>${formatMoney(0, DEFAULT_CURRENCY)}</span></div>`;
        }

        if (cartWhatsapp) cartWhatsapp.disabled = carrito.length === 0;
      }

      function agregarAlCarrito(id: string, nombre: string, precio: number, fotoUrl: string, moneda: string) {
        const monedaValida = isValidCurrency(moneda) ? moneda : DEFAULT_CURRENCY;
        const existente = carrito.find((item) => item.id === id);
        if (existente) {
          existente.cantidad += 1;
        } else {
          carrito.push({ id, nombre, precio, fotoUrl, cantidad: 1, moneda: monedaValida });
        }
        guardarCarrito();
        renderCarrito();
      }

      function cambiarCantidad(id: string, delta: number) {
        const item = carrito.find((i) => i.id === id);
        if (!item) return;
        item.cantidad += delta;
        if (item.cantidad <= 0) {
          carrito = carrito.filter((i) => i.id !== id);
        }
        guardarCarrito();
        renderCarrito();
      }

      function eliminarDelCarrito(id: string) {
        carrito = carrito.filter((i) => i.id !== id);
        guardarCarrito();
        renderCarrito();
      }

      function abrirCarrito() {
        cartOverlay?.removeAttribute("hidden");
        cartDrawer?.classList.add("abierto");
        cartDrawer?.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function cerrarCarrito() {
        cartOverlay?.setAttribute("hidden", "");
        cartDrawer?.classList.remove("abierto");
        cartDrawer?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      btnCarrito?.addEventListener("click", abrirCarrito);
      cartCerrar?.addEventListener("click", cerrarCarrito);
      cartOverlay?.addEventListener("click", cerrarCarrito);

      document.querySelectorAll<HTMLButtonElement>(".btn-agregar").forEach((btn) => {
        btn.addEventListener("click", () => {
          const { id, nombre, precio, foto, moneda } = btn.dataset;
          if (!id || !nombre || !precio || !foto || !moneda) return;
          agregarAlCarrito(id, nombre, Number(precio), foto, moneda);
        });
      });

      cartItemsEl?.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-accion]");
        if (!btn) return;
        const id = btn.closest<HTMLElement>(".cart-item")?.dataset.id;
        if (!id) return;

        if (btn.dataset.accion === "sumar") cambiarCantidad(id, 1);
        if (btn.dataset.accion === "restar") cambiarCantidad(id, -1);
        if (btn.dataset.accion === "eliminar") eliminarDelCarrito(id);
      });

      async function obtenerStockDisponible(items: CartItem[]): Promise<Record<string, number> | undefined> {
        try {
          const response = await fetch("/api/pedido", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              items: items.map((item) => ({ id: item.id, cantidad: item.cantidad })),
            }),
          });
          if (!response.ok) return undefined;
          const data = await response.json();
          const porId: Record<string, number> = {};
          for (const { id, stockDisponible } of data.items ?? []) {
            porId[id] = stockDisponible;
          }
          return porId;
        } catch {
          return undefined;
        }
      }

      cartWhatsapp?.addEventListener("click", async () => {
        if (carrito.length === 0) return;
        const ventana = window.open("", "_blank");
        const stockPorId = await obtenerStockDisponible(carrito);
        const mensaje = buildWhatsAppMessage(carrito, stockPorId, {
          saludo: ORDER_GREETING,
          cierre: ORDER_CLOSING,
          infoEnvio: DELIVERY_INFO,
          infoRetiro: PICKUP_INFO,
        });
        const url = buildWhatsAppUrl(WHATSAPP_PHONE, mensaje);
        if (ventana) {
          ventana.location.href = url;
        } else {
          window.open(url, "_blank", "noopener");
        }
      });

      cartVaciar?.addEventListener("click", () => {
        if (carrito.length === 0) return;
        if (!confirm("¿Vaciar el carrito? Se van a quitar todos los productos.")) return;
        carrito = [];
        guardarCarrito();
        renderCarrito();
      });

      renderCarrito();

      const btnMediosPago = document.getElementById("btn-medios-pago");
      const mediosOverlay = document.getElementById("medios-overlay");
      const mediosModal = document.getElementById("medios-modal");
      const mediosCerrar = document.getElementById("medios-cerrar");

      function abrirMediosPago() {
        mediosOverlay?.removeAttribute("hidden");
        mediosModal?.classList.add("abierto");
        mediosModal?.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function cerrarMediosPago() {
        mediosOverlay?.setAttribute("hidden", "");
        mediosModal?.classList.remove("abierto");
        mediosModal?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      btnMediosPago?.addEventListener("click", abrirMediosPago);
      mediosCerrar?.addEventListener("click", cerrarMediosPago);
      mediosOverlay?.addEventListener("click", cerrarMediosPago);
    </script>
  </body>
</html>
