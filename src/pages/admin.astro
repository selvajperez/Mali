---
import { CATEGORIES } from "../lib/categories";
import { listAllProducts } from "../lib/sheetsWrite";

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "srxrmckc";
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "mute-products";

let products: Awaited<ReturnType<typeof listAllProducts>> = [];
let listError: string | null = null;

try {
  products = await listAllProducts();
} catch (e) {
  listError = e instanceof Error ? e.message : "Error desconocido";
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MUTE - Administración</title>
  </head>
  <body>
    <header>
      <h1>MUTE - Administración</h1>
    </header>

    <main>
      <section class="seccion">
        <h2 id="form-titulo">Publicar producto nuevo</h2>
        <form id="form-producto">
          <div class="campo" id="campo-foto">
            <label>Foto</label>

            <div class="foto-acciones">
              <button type="button" id="btn-sacar-foto">Sacar foto</button>
              <button type="button" id="btn-elegir-galeria">Elegir de galería</button>
            </div>
            <input type="file" id="input-galeria" accept="image/*" hidden />

            <div id="camara-contenedor" hidden>
              <video id="video-preview" playsinline autoplay muted></video>
              <div class="camara-botones">
                <button type="button" id="btn-capturar">Capturar</button>
                <button type="button" id="btn-cancelar-camara">Cancelar</button>
              </div>
            </div>

            <p id="foto-mensaje" role="status"></p>
            <img id="preview" alt="" hidden />
            <input type="hidden" id="fotoUrl" name="fotoUrl" required />
          </div>

          <div class="campo">
            <label for="producto">Producto</label>
            <input type="text" id="producto" name="producto" required />
          </div>

          <div class="campo">
            <label for="precio">Precio</label>
            <input type="number" id="precio" name="precio" min="0" step="1" required />
          </div>

          <div class="campo">
            <label for="categoria">Categoría</label>
            <select id="categoria" name="categoria" required>
              <option value="" disabled selected>Elegí una categoría</option>
              {CATEGORIES.map((cat) => <option value={cat}>{cat}</option>)}
            </select>
          </div>

          <div class="campo">
            <label for="stock">Stock</label>
            <input type="number" id="stock" name="stock" min="0" step="1" required />
          </div>

          <button type="submit" id="btn-publicar">Publicar</button>
          <button type="button" id="btn-cancelar-edicion" hidden>Cancelar edición</button>
          <p id="mensaje" role="status"></p>
        </form>
      </section>

      <section class="seccion">
        <h2>Productos existentes</h2>
        <p id="mensaje-lista" role="status"></p>

        {listError && <p class="error">No se pudo cargar la lista: {listError}</p>}
        {!listError && products.length === 0 && <p>Todavía no hay productos cargados.</p>}

        {!listError && products.map((product) => (
          <article class="product-card" data-product-id={product.id}>
            <div class="vista" data-role="vista">
              <img src={product.fotoUrl} alt={product.producto} />
              <div class="info">
                <h3>{product.producto}</h3>
                <p>${product.precio.toLocaleString("es-AR")} · {product.categoria}</p>
                <p>Stock: {product.stock}</p>
                <span class={`badge ${product.activo ? "badge-activo" : "badge-inactivo"}`}>
                  {product.activo ? "Activo" : "Inactivo"}
                </span>
              </div>
              <div class="acciones">
                <button
                  type="button"
                  class="btn-editar"
                  data-id={product.id}
                  data-producto={product.producto}
                  data-precio={product.precio}
                  data-categoria={product.categoria}
                  data-stock={product.stock}
                  data-foto={product.fotoUrl}
                >
                  Editar
                </button>
                <button
                  type="button"
                  class="btn-toggle-activo"
                  data-activo={String(product.activo)}
                >
                  {product.activo ? "Desactivar" : "Activar"}
                </button>
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #fafafa;
        color: #222;
      }
      header {
        padding: 1rem;
        background: #fff;
        border-bottom: 1px solid #eee;
      }
      header h1 {
        margin: 0;
        font-size: 1.25rem;
      }
      main {
        padding: 1rem;
        max-width: 480px;
        margin: 0 auto;
      }
      .seccion {
        margin-bottom: 2rem;
      }
      .seccion h2 {
        font-size: 1.1rem;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .campo {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .campo[hidden] {
        display: none;
      }
      label {
        font-weight: 600;
      }
      input,
      select,
      button {
        font-size: 1rem;
        padding: 0.6rem;
        border-radius: 8px;
        border: 1px solid #ccc;
      }
      .foto-acciones {
        display: flex;
        gap: 0.5rem;
      }
      .foto-acciones button {
        flex: 1;
        background: #fff;
      }
      #camara-contenedor {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      #video-preview {
        width: 100%;
        max-width: 320px;
        border-radius: 8px;
        background: #222;
      }
      .camara-botones {
        display: flex;
        gap: 0.5rem;
      }
      .camara-botones button {
        flex: 1;
      }
      #foto-mensaje {
        min-height: 1.2rem;
        margin: 0;
      }
      #foto-mensaje.error {
        color: #a11f1f;
      }
      #foto-mensaje.ok {
        color: #1a7a3c;
      }
      #preview {
        max-width: 160px;
        border-radius: 8px;
      }
      #btn-publicar {
        background: #1a7a3c;
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 0.9rem;
      }
      #btn-publicar:disabled {
        opacity: 0.6;
      }
      #mensaje,
      #mensaje-lista {
        min-height: 1.2rem;
      }
      #mensaje.error,
      #mensaje-lista.error {
        color: #a11f1f;
      }
      #mensaje.ok,
      #mensaje-lista.ok {
        color: #1a7a3c;
      }
      .error {
        color: #a11f1f;
      }

      .product-card {
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .vista {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        flex-wrap: wrap;
      }
      .vista img {
        width: 64px;
        height: 64px;
        object-fit: cover;
        border-radius: 8px;
        background: #f2f2f2;
        flex-shrink: 0;
      }
      .info {
        flex: 1;
        min-width: 140px;
      }
      .info h3 {
        margin: 0 0 0.15rem;
        font-size: 1rem;
      }
      .info p {
        margin: 0.1rem 0;
        font-size: 0.9rem;
        color: #555;
      }
      .badge {
        display: inline-block;
        margin-top: 0.25rem;
        font-size: 0.8rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        font-weight: 600;
      }
      .badge-activo {
        background: #dcf5e3;
        color: #1a7a3c;
      }
      .badge-inactivo {
        background: #eee;
        color: #666;
      }
      .acciones {
        display: flex;
        gap: 0.5rem;
        width: 100%;
        margin-top: 0.5rem;
      }
      .acciones button {
        flex: 1;
        padding: 0.5rem;
      }
      #form-producto {
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid transparent;
        transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
      }
      #form-producto.modo-edicion {
        border-color: #f0b429;
        background: #fffbea;
        box-shadow: 0 0 0 3px rgba(240, 180, 41, 0.15);
      }
      #btn-cancelar-edicion {
        background: #fff;
      }
    </style>

    <script define:vars={{ cloudName, uploadPreset }} is:inline>
      const fotoUrlInput = document.getElementById("fotoUrl");
      const preview = document.getElementById("preview");
      const mensaje = document.getElementById("mensaje");
      const form = document.getElementById("form-producto");
      const btnPublicar = document.getElementById("btn-publicar");
      const btnCancelarEdicion = document.getElementById("btn-cancelar-edicion");
      const formTitulo = document.getElementById("form-titulo");
      const campoProducto = document.getElementById("producto");
      const campoPrecio = document.getElementById("precio");
      const campoCategoria = document.getElementById("categoria");
      const campoStock = document.getElementById("stock");

      let editingId = null;

      function entrarModoEdicion(datos) {
        editingId = datos.id;
        formTitulo.textContent = `Editando: ${datos.producto}`;
        form.classList.add("modo-edicion");
        btnPublicar.textContent = "Guardar cambios";
        btnCancelarEdicion.hidden = false;
        fotoUrlInput.value = datos.foto;
        preview.src = datos.foto;
        preview.hidden = false;
        campoProducto.value = datos.producto;
        campoPrecio.value = datos.precio;
        campoCategoria.value = datos.categoria;
        campoStock.value = datos.stock;
        mensaje.textContent = "";
        mensaje.className = "";
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function salirModoEdicion() {
        editingId = null;
        formTitulo.textContent = "Publicar producto nuevo";
        form.classList.remove("modo-edicion");
        btnPublicar.textContent = "Publicar";
        btnCancelarEdicion.hidden = true;
        form.reset();
        fotoUrlInput.value = "";
        preview.hidden = true;
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";
      }

      btnCancelarEdicion.addEventListener("click", salirModoEdicion);

      // --- Foto: mismo mecanismo validado en /test-camera (getUserMedia +
      // canvas, o galeria + resize), sin depender del Cloudinary Upload
      // Widget, que fallaba con "Memoria insuficiente" al sacar fotos desde
      // la camara nativa de Android en equipos de gama media. ---
      function dibujarEnCanvas(source, srcWidth, srcHeight, maxWidth, maxHeight, calidad) {
        const escala = Math.min(1, maxWidth / srcWidth, maxHeight / srcHeight);
        const width = Math.round(srcWidth * escala);
        const height = Math.round(srcHeight * escala);

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        canvas.getContext("2d").drawImage(source, 0, 0, width, height);

        return new Promise((resolve, reject) => {
          canvas.toBlob(
            (blob) => (blob ? resolve({ blob, width, height }) : reject(new Error("No se pudo generar el JPEG"))),
            "image/jpeg",
            calidad
          );
        });
      }

      async function archivoAResizedBlob(file, maxWidth, maxHeight, calidad) {
        const bitmap = await createImageBitmap(file);
        try {
          return await dibujarEnCanvas(bitmap, bitmap.width, bitmap.height, maxWidth, maxHeight, calidad);
        } finally {
          bitmap.close();
        }
      }

      async function subirACloudinary(blob) {
        const formData = new FormData();
        formData.append("file", blob, "foto.jpg");
        formData.append("upload_preset", uploadPreset);

        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (!res.ok) {
          const cuerpo = await res.json().catch(() => ({}));
          throw new Error(cuerpo?.error?.message || `Error HTTP ${res.status}`);
        }

        return res.json();
      }

      function mostrarFotoOk(info) {
        preview.src = info.secure_url;
        preview.hidden = false;
        fotoUrlInput.value = info.secure_url;
        fotoMensaje.textContent = "Foto lista.";
        fotoMensaje.className = "ok";
      }

      function mostrarFotoError(err) {
        fotoMensaje.textContent = "No se pudo procesar la foto: " + (err?.message || String(err));
        fotoMensaje.className = "error";
      }

      const fotoMensaje = document.getElementById("foto-mensaje");
      const btnSacarFoto = document.getElementById("btn-sacar-foto");
      const btnElegirGaleria = document.getElementById("btn-elegir-galeria");
      const inputGaleria = document.getElementById("input-galeria");
      const camaraContenedor = document.getElementById("camara-contenedor");
      const video = document.getElementById("video-preview");
      const btnCapturar = document.getElementById("btn-capturar");
      const btnCancelarCamara = document.getElementById("btn-cancelar-camara");

      let stream = null;

      function esperarVideoListo(videoEl) {
        if (videoEl.videoWidth > 0) return Promise.resolve();
        return new Promise((resolve) => {
          videoEl.addEventListener("loadedmetadata", () => resolve(), { once: true });
        });
      }

      function cerrarCamara() {
        stream?.getTracks().forEach((track) => track.stop());
        stream = null;
        camaraContenedor.hidden = true;
        video.srcObject = null;
        btnSacarFoto.disabled = false;
        btnElegirGaleria.disabled = false;
      }

      btnSacarFoto.addEventListener("click", async () => {
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";

        if (!navigator.mediaDevices?.getUserMedia) {
          fotoMensaje.textContent = "Este navegador no permite usar la cámara acá. Usá 'Elegir de galería'.";
          fotoMensaje.className = "error";
          return;
        }

        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: {
              facingMode: { ideal: "environment" },
              width: { ideal: 1280 },
              height: { ideal: 960 },
            },
            audio: false,
          });
          video.srcObject = stream;
          camaraContenedor.hidden = false;
          btnSacarFoto.disabled = true;
          btnElegirGaleria.disabled = true;
        } catch (err) {
          fotoMensaje.textContent =
            "No se pudo acceder a la cámara: " + (err?.message || String(err)) + ". Usá 'Elegir de galería'.";
          fotoMensaje.className = "error";
        }
      });

      btnCapturar.addEventListener("click", async () => {
        fotoMensaje.textContent = "Subiendo foto...";
        fotoMensaje.className = "";

        try {
          await esperarVideoListo(video);
          const { blob } = await dibujarEnCanvas(video, video.videoWidth, video.videoHeight, 1280, 960, 0.85);
          cerrarCamara(); // ya tenemos el blob: apagamos la camara antes de subir
          const info = await subirACloudinary(blob);
          mostrarFotoOk(info);
        } catch (err) {
          cerrarCamara();
          mostrarFotoError(err);
        }
      });

      btnCancelarCamara.addEventListener("click", cerrarCamara);
      window.addEventListener("pagehide", cerrarCamara);

      btnElegirGaleria.addEventListener("click", () => inputGaleria.click());

      inputGaleria.addEventListener("change", async () => {
        const file = inputGaleria.files?.[0];
        inputGaleria.value = "";
        if (!file) return;

        fotoMensaje.textContent = "Subiendo foto...";
        fotoMensaje.className = "";

        try {
          const { blob } = await archivoAResizedBlob(file, 1280, 960, 0.85);
          const info = await subirACloudinary(blob);
          mostrarFotoOk(info);
        } catch (err) {
          mostrarFotoError(err);
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        mensaje.textContent = "";
        mensaje.className = "";

        const editando = editingId !== null;

        if (!editando && !fotoUrlInput.value) {
          mensaje.textContent = "Elegí una foto antes de publicar.";
          mensaje.className = "error";
          return;
        }

        const payload = {
          fotoUrl: fotoUrlInput.value,
          producto: campoProducto.value,
          precio: Number(campoPrecio.value),
          categoria: campoCategoria.value,
          stock: Number(campoStock.value),
        };

        btnPublicar.disabled = true;
        mensaje.textContent = editando ? "Guardando cambios..." : "Publicando...";

        try {
          const res = await fetch(editando ? `/api/products/${editingId}` : "/api/products", {
            method: editando ? "PATCH" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || `Error HTTP ${res.status}`);
          }

          if (editando) {
            location.reload();
            return;
          }

          mensaje.textContent = "Producto publicado.";
          mensaje.className = "ok";
          form.reset();
          preview.hidden = true;
          fotoUrlInput.value = "";
          fotoMensaje.textContent = "";
          fotoMensaje.className = "";
        } catch (err) {
          mensaje.textContent = (editando ? "No se pudo guardar: " : "No se pudo publicar: ") + err.message;
          mensaje.className = "error";
        } finally {
          btnPublicar.disabled = false;
        }
      });

      const mensajeLista = document.getElementById("mensaje-lista");

      function mostrarErrorLista(texto) {
        mensajeLista.textContent = texto;
        mensajeLista.className = "error";
      }

      document.querySelectorAll(".product-card").forEach((card) => {
        const id = card.dataset.productId;

        card.querySelector(".btn-editar").addEventListener("click", (e) => {
          const btn = e.currentTarget;
          entrarModoEdicion({
            id: btn.dataset.id,
            producto: btn.dataset.producto,
            precio: btn.dataset.precio,
            categoria: btn.dataset.categoria,
            stock: btn.dataset.stock,
            foto: btn.dataset.foto,
          });
        });

        card.querySelector(".btn-toggle-activo").addEventListener("click", async (e) => {
          const btn = e.currentTarget;
          const activoActual = btn.dataset.activo === "true";
          btn.disabled = true;
          try {
            const res = await fetch(`/api/products/${id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ activo: !activoActual }),
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.error || `Error HTTP ${res.status}`);
            }
            location.reload();
          } catch (err) {
            mostrarErrorLista("No se pudo actualizar el estado: " + err.message);
            btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
