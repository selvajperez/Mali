---
import { CATEGORIES } from "../lib/categories";
import { CURRENCIES, formatMoney } from "../lib/currencies";
import { listAllProducts } from "../lib/sheetsWrite";
import PublicationModal from "../components/PublicationModal.astro";
import {
  STORE_NAME,
  BRAND_COLOR,
  DEFAULT_CURRENCY,
  QUICK_ADD_DEFAULT_CATEGORY,
  QUICK_ADD_DEFAULT_STOCK,
  FONT_HEADING,
  FONT_BODY,
  BACKGROUND_COLOR,
  GOOGLE_FONTS_URL,
  STORE_LOGO_URL,
  PARENT_BRAND_MARK_URL,
} from "../lib/storeConfig";

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET;

if (!cloudName || !uploadPreset) {
  throw new Error(
    "Faltan las variables de entorno PUBLIC_CLOUDINARY_CLOUD_NAME y/o PUBLIC_CLOUDINARY_UPLOAD_PRESET."
  );
}

let products: Awaited<ReturnType<typeof listAllProducts>> = [];
let listError: string | null = null;

try {
  products = await listAllProducts();
} catch (e) {
  listError = e instanceof Error ? e.message : "Error desconocido";
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{STORE_NAME} - Administración</title>
    {GOOGLE_FONTS_URL && <link rel="stylesheet" href={GOOGLE_FONTS_URL} />}
  </head>
  <body>
    <header>
      {STORE_LOGO_URL ? (
        <img src={STORE_LOGO_URL} alt={STORE_NAME} class="logo-img" />
      ) : (
        <h1>
          {PARENT_BRAND_MARK_URL && (
            <img src={PARENT_BRAND_MARK_URL} alt="" class="logo-mark" />
          )}
          {STORE_NAME} - Administración
        </h1>
      )}
    </header>

    <main>
      <section class="seccion">
        <h2 id="form-titulo">Publicar producto nuevo</h2>

        <div class="modo-carga" role="tablist" aria-label="Modo de carga">
          <button type="button" id="btn-modo-rapido" class="btn-modo" role="tab">Carga rápida</button>
          <button type="button" id="btn-modo-completa" class="btn-modo" role="tab">Carga completa</button>
        </div>

        <form id="form-producto">
          <div class="campo" id="campo-foto">
            <label>Foto</label>

            <div class="foto-acciones">
              <button type="button" id="btn-sacar-foto">Sacar foto</button>
              <button type="button" id="btn-elegir-galeria">Elegir de galería</button>
            </div>
            <input type="file" id="input-galeria" accept="image/*" hidden />

            <div id="camara-contenedor" hidden>
              <video id="video-preview" playsinline autoplay muted></video>
              <div class="camara-botones">
                <button type="button" id="btn-capturar">Capturar</button>
                <button type="button" id="btn-cancelar-camara">Cancelar</button>
              </div>
            </div>

            <div id="ajuste-contenedor" hidden>
              <div class="crop-caja">
                <canvas id="crop-canvas" width="1024" height="1280"></canvas>
              </div>
              <input type="range" id="zoom-slider" min="0" max="100" value="0" aria-label="Zoom" />
              <div class="camara-botones">
                <button type="button" id="btn-confirmar-ajuste">Confirmar</button>
                <button type="button" id="btn-cancelar-ajuste">Cancelar</button>
              </div>
            </div>

            <p id="foto-mensaje" role="status"></p>
            <img id="preview" alt="" hidden />
            <input type="hidden" id="fotoUrl" name="fotoUrl" required />
          </div>

          <div class="campo">
            <label for="producto">Producto</label>
            <input type="text" id="producto" name="producto" required />
          </div>

          <div class="campo">
            <label for="precio">Precio</label>
            <input type="number" id="precio" name="precio" min="0" step="1" required />
          </div>

          <div class="campo" id="campo-moneda">
            <label for="moneda">Moneda</label>
            <select id="moneda" name="moneda" required>
              {CURRENCIES.map((m) => <option value={m} selected={m === DEFAULT_CURRENCY}>{m}</option>)}
            </select>
          </div>

          <div class="campo" id="campo-categoria">
            <label for="categoria">Categoría</label>
            <select id="categoria" name="categoria" required>
              <option value="" disabled selected>Elegí una categoría</option>
              {CATEGORIES.map((cat) => <option value={cat}>{cat}</option>)}
            </select>
          </div>

          <div class="campo" id="campo-stock">
            <label for="stock">Stock</label>
            <input type="number" id="stock" name="stock" min="0" step="1" required />
          </div>

          <button type="submit" id="btn-publicar">Publicar</button>
          <button type="button" id="btn-cancelar-edicion" hidden>Cancelar edición</button>
          <p id="mensaje" role="status"></p>
        </form>
      </section>

      <section class="seccion">
        <h2>Productos existentes</h2>
        <p id="mensaje-lista" role="status"></p>

        {listError && <p class="error">No se pudo cargar la lista: {listError}</p>}
        {!listError && products.length === 0 && <p>Todavía no hay productos cargados.</p>}

        {!listError && products.some((p) => p.activo) && (
          <div id="barra-publicacion" class="barra-publicacion">
            <div class="barra-publicacion-fila">
              <span id="contador-seleccion">0 seleccionados</span>
              <button type="button" id="btn-preparar-publicacion" disabled>
                Preparar publicación
              </button>
            </div>
            <div class="barra-publicacion-fila">
              <button type="button" id="btn-seleccionar-todos" class="btn-seleccion-masiva">
                Seleccionar todos
              </button>
              <button type="button" id="btn-deseleccionar-todos" class="btn-seleccion-masiva">
                Deseleccionar todos
              </button>
              <button type="button" id="btn-eliminar-seleccionados" class="btn-eliminar-masiva" disabled>
                Eliminar seleccionados
              </button>
            </div>
          </div>
        )}
        <p id="mensaje-publicacion" role="status"></p>

        {!listError && products.map((product) => (
            <article class="product-card" data-product-id={product.id}>
              <div class="vista" data-role="vista">
                {product.activo && (
                  <input
                    type="checkbox"
                    class="chk-publicacion"
                    data-id={product.id}
                    aria-label={`Seleccionar ${product.producto} para publicación`}
                  />
                )}
                <img src={product.fotoUrl} alt={product.producto} />
                <div class="info">
                  <h3>{product.producto}</h3>
                  <p>{formatMoney(product.precio, product.moneda)} · {product.categoria}</p>
                  <p>Stock: {product.stock}</p>
                  <span class={`badge ${product.activo ? "badge-activo" : "badge-inactivo"}`}>
                    {product.activo ? "Activo" : "Inactivo"}
                  </span>
                </div>
                <div class="acciones">
                  <button
                    type="button"
                    class="btn-editar"
                    data-id={product.id}
                    data-producto={product.producto}
                    data-precio={product.precio}
                    data-categoria={product.categoria}
                    data-stock={product.stock}
                    data-foto={product.fotoUrl}
                    data-moneda={product.moneda}
                  >
                    Editar
                  </button>
                  <button
                    type="button"
                    class="btn-toggle-activo"
                    data-activo={String(product.activo)}
                  >
                    {product.activo ? "Desactivar" : "Activar"}
                  </button>
                </div>
              </div>
            </article>
          ))}
      </section>
    </main>

    <PublicationModal brandColor={BRAND_COLOR} fontHeading={FONT_HEADING} />

    <style
      define:vars={{
        brandColor: BRAND_COLOR,
        fontHeading: FONT_HEADING,
        fontBody: FONT_BODY,
        backgroundColor: BACKGROUND_COLOR,
      }}
    >
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: var(--fontBody);
        background: var(--backgroundColor);
        color: #222;
      }
      header {
        padding: 1rem;
        background: #000;
        border-bottom: 2px solid var(--brandColor);
      }
      header h1 {
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--fontHeading);
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--brandColor);
      }
      .logo-img {
        max-height: 2rem;
        max-width: 80vw;
        display: block;
      }
      .logo-mark {
        height: 1.5rem;
        width: auto;
        display: block;
        flex-shrink: 0;
      }
      main {
        padding: 1rem;
        max-width: 480px;
        margin: 0 auto;
      }
      .seccion {
        margin-bottom: 2rem;
      }
      .seccion h2 {
        font-family: var(--fontHeading);
        font-size: 1.1rem;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .campo {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .campo[hidden] {
        display: none;
      }
      label {
        font-weight: 600;
      }
      input,
      select,
      button {
        font-size: 1rem;
        padding: 0.6rem;
        border-radius: 8px;
        border: 1px solid #ccc;
      }
      .foto-acciones {
        display: flex;
        gap: 0.5rem;
      }
      .foto-acciones button {
        flex: 1;
        background: #fff;
      }
      #camara-contenedor {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      #camara-contenedor[hidden] {
        display: none;
      }
      #video-preview {
        width: 100%;
        max-width: 320px;
        border-radius: 8px;
        background: #222;
      }
      .camara-botones {
        display: flex;
        gap: 0.5rem;
      }
      .camara-botones button {
        flex: 1;
      }
      #ajuste-contenedor {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      #ajuste-contenedor[hidden] {
        display: none;
      }
      .crop-caja {
        width: min(280px, 80vw);
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border-radius: 8px;
        background: #222;
        touch-action: none;
        margin: 0 auto;
      }
      #crop-canvas {
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none;
      }
      #zoom-slider {
        width: min(280px, 80vw);
        margin: 0 auto;
        padding: 0;
        border: none;
      }
      #foto-mensaje {
        min-height: 1.2rem;
        margin: 0;
      }
      #foto-mensaje.error {
        color: #a11f1f;
      }
      #foto-mensaje.ok {
        color: #1a7a3c;
      }
      #preview {
        max-width: 160px;
        border-radius: 8px;
      }
      #btn-publicar {
        background: var(--brandColor);
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 0.9rem;
      }
      #btn-publicar:disabled {
        opacity: 0.6;
      }
      #mensaje,
      #mensaje-lista {
        min-height: 1.2rem;
      }
      #mensaje.error,
      #mensaje-lista.error {
        color: #a11f1f;
      }
      #mensaje.ok,
      #mensaje-lista.ok {
        color: #1a7a3c;
      }
      .error {
        color: #a11f1f;
      }

      .barra-publicacion {
        position: sticky;
        top: 0;
        z-index: 5;
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .barra-publicacion-fila {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }
      #contador-seleccion {
        font-weight: 600;
        font-size: 0.9rem;
        color: #555;
      }
      #btn-preparar-publicacion {
        background: var(--brandColor);
        color: #fff;
        border: none;
        font-weight: 700;
        padding: 0.7rem 1rem;
        white-space: nowrap;
      }
      #btn-preparar-publicacion:disabled {
        opacity: 0.5;
      }
      .btn-seleccion-masiva {
        flex: 1;
        background: #fff;
        border: 1px solid #ccc;
        font-size: 0.85rem;
        padding: 0.5rem;
      }
      .btn-eliminar-masiva {
        flex: 1;
        background: var(--brandColor);
        color: #fff;
        border: none;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.5rem;
      }
      .btn-eliminar-masiva:disabled {
        opacity: 0.5;
      }
      #mensaje-publicacion {
        min-height: 1.2rem;
      }
      #mensaje-publicacion.aviso {
        color: #8a6100;
      }
      .product-card {
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .vista {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        flex-wrap: wrap;
      }
      .chk-publicacion {
        width: 1.5rem;
        height: 1.5rem;
        flex-shrink: 0;
        margin: 0.1rem 0 0;
      }
      .vista img {
        width: 64px;
        height: 64px;
        object-fit: cover;
        border-radius: 8px;
        background: #f2f2f2;
        flex-shrink: 0;
      }
      .info {
        flex: 1;
        min-width: 140px;
      }
      .info h3 {
        margin: 0 0 0.15rem;
        font-size: 1rem;
      }
      .info p {
        margin: 0.1rem 0;
        font-size: 0.9rem;
        color: #555;
      }
      .badge {
        display: inline-block;
        margin-top: 0.25rem;
        font-size: 0.8rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        font-weight: 600;
      }
      .badge-activo {
        background: #dcf5e3;
        color: #1a7a3c;
      }
      .badge-inactivo {
        background: #eee;
        color: #666;
      }
      .acciones {
        display: flex;
        gap: 0.5rem;
        width: 100%;
        margin-top: 0.5rem;
      }
      .acciones button {
        flex: 1;
        padding: 0.5rem;
      }
      .modo-carga {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }
      .btn-modo {
        flex: 1;
        background: #fff;
        color: #444;
      }
      .btn-modo.activo {
        background: var(--brandColor);
        color: #fff;
        border-color: var(--brandColor);
      }
      #form-producto {
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid transparent;
        transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
      }
      #form-producto.modo-edicion {
        border-color: #f0b429;
        background: #fffbea;
        box-shadow: 0 0 0 3px rgba(240, 180, 41, 0.15);
      }
      #btn-cancelar-edicion {
        background: #fff;
      }
    </style>

    <script
      define:vars={{ cloudName, uploadPreset, quickAddDefaultCategory: QUICK_ADD_DEFAULT_CATEGORY, quickAddDefaultStock: QUICK_ADD_DEFAULT_STOCK, defaultCurrency: DEFAULT_CURRENCY }}
      is:inline
    >
      const fotoUrlInput = document.getElementById("fotoUrl");
      const preview = document.getElementById("preview");
      const mensaje = document.getElementById("mensaje");
      const form = document.getElementById("form-producto");
      const btnPublicar = document.getElementById("btn-publicar");
      const btnCancelarEdicion = document.getElementById("btn-cancelar-edicion");
      const formTitulo = document.getElementById("form-titulo");
      const campoProducto = document.getElementById("producto");
      const campoPrecio = document.getElementById("precio");
      const campoMoneda = document.getElementById("moneda");
      const campoCategoria = document.getElementById("categoria");
      const campoStock = document.getElementById("stock");

      // --- Carga rápida vs. Carga completa: mismo formulario, mismo submit,
      // mismo endpoint. Solo se ocultan Moneda/Categoría/Stock y se les
      // precarga un valor por defecto (storeConfig.ts); al ocultarlos con el
      // atributo "hidden" quedan afuera de la validación HTML5, así que no
      // bloquean el submit aunque sigan "required". ---
      const btnModoRapido = document.getElementById("btn-modo-rapido");
      const btnModoCompleta = document.getElementById("btn-modo-completa");
      const campoMonedaDiv = document.getElementById("campo-moneda");
      const campoCategoriaDiv = document.getElementById("campo-categoria");
      const campoStockDiv = document.getElementById("campo-stock");

      let modoActual = "rapido";

      function aplicarModoCarga(modo) {
        modoActual = modo;
        const esRapido = modo === "rapido";
        campoMonedaDiv.hidden = esRapido;
        // Sin categoría por defecto (quickAddDefaultCategory === ""), el
        // campo queda visible también en Carga rápida: no hay valor válido
        // para precargar en un campo oculto.
        campoCategoriaDiv.hidden = esRapido && Boolean(quickAddDefaultCategory);
        campoStockDiv.hidden = esRapido;
        if (esRapido) {
          campoMoneda.value = defaultCurrency;
          if (quickAddDefaultCategory) campoCategoria.value = quickAddDefaultCategory;
          campoStock.value = quickAddDefaultStock;
        }
        btnModoRapido.classList.toggle("activo", esRapido);
        btnModoCompleta.classList.toggle("activo", !esRapido);
      }

      btnModoRapido.addEventListener("click", () => aplicarModoCarga("rapido"));
      btnModoCompleta.addEventListener("click", () => aplicarModoCarga("completa"));

      // Arranca en Carga rápida: es el flujo pensado para publicar parado en
      // el local/proveedor, sacando la foto y cargando nombre + precio.
      aplicarModoCarga("rapido");

      let editingId = null;

      function entrarModoEdicion(datos) {
        editingId = datos.id;
        aplicarModoCarga("completa");
        formTitulo.textContent = `Editando: ${datos.producto}`;
        form.classList.add("modo-edicion");
        btnPublicar.textContent = "Guardar cambios";
        btnCancelarEdicion.hidden = false;
        fotoUrlInput.value = datos.foto;
        preview.src = datos.foto;
        preview.hidden = false;
        campoProducto.value = datos.producto;
        campoPrecio.value = datos.precio;
        campoMoneda.value = datos.moneda;
        campoCategoria.value = datos.categoria;
        campoStock.value = datos.stock;
        mensaje.textContent = "";
        mensaje.className = "";
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function salirModoEdicion() {
        editingId = null;
        formTitulo.textContent = "Publicar producto nuevo";
        form.classList.remove("modo-edicion");
        btnPublicar.textContent = "Publicar";
        btnCancelarEdicion.hidden = true;
        form.reset();
        fotoUrlInput.value = "";
        preview.hidden = true;
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";
        aplicarModoCarga("rapido");
      }

      btnCancelarEdicion.addEventListener("click", salirModoEdicion);

      // --- Foto: mismo mecanismo validado en /test-camera (getUserMedia,
      // sin depender del Cloudinary Upload Widget, que fallaba con "Memoria
      // insuficiente" al sacar fotos desde la camara nativa de Android en
      // equipos de gama media), mas un paso de ajuste (recorte 4:5, mover y
      // zoom) antes de redimensionar y subir. ---

      // Tamaño final fijo (tambien es la resolucion interna del canvas de
      // ajuste, asi "Confirmar" ya genera el JPEG final sin un segundo
      // resize). Formato 4:5. Se deja como constante para poder generar mas
      // adelante otros formatos (ej. cuadrado para redes) sin tocar la
      // lógica de recorte/zoom, solo estos dos numeros.
      const CROP_WIDTH = 1024;
      const CROP_HEIGHT = 1280;
      const ZOOM_MAX_MULTIPLIER = 3;

      const ajusteContenedor = document.getElementById("ajuste-contenedor");
      const cropCanvas = document.getElementById("crop-canvas");
      const cropCtx = cropCanvas.getContext("2d");
      const zoomSlider = document.getElementById("zoom-slider");
      const btnConfirmarAjuste = document.getElementById("btn-confirmar-ajuste");
      const btnCancelarAjuste = document.getElementById("btn-cancelar-ajuste");

      let cropBitmap = null;
      let cropNaturalWidth = 0;
      let cropNaturalHeight = 0;
      let cropMinScale = 1;
      let cropScale = 1;
      let cropCenterX = 0;
      let cropCenterY = 0;
      let cropDragging = false;
      let cropDragStartX = 0;
      let cropDragStartY = 0;
      let cropDragStartCenterX = 0;
      let cropDragStartCenterY = 0;

      function clampCropCenter() {
        const sWidth = CROP_WIDTH / cropScale;
        const sHeight = CROP_HEIGHT / cropScale;
        cropCenterX = Math.min(Math.max(cropCenterX, sWidth / 2), cropNaturalWidth - sWidth / 2);
        cropCenterY = Math.min(Math.max(cropCenterY, sHeight / 2), cropNaturalHeight - sHeight / 2);
      }

      function dibujarCrop() {
        const sWidth = CROP_WIDTH / cropScale;
        const sHeight = CROP_HEIGHT / cropScale;
        const sx = cropCenterX - sWidth / 2;
        const sy = cropCenterY - sHeight / 2;
        cropCtx.clearRect(0, 0, CROP_WIDTH, CROP_HEIGHT);
        cropCtx.drawImage(cropBitmap, sx, sy, sWidth, sHeight, 0, 0, CROP_WIDTH, CROP_HEIGHT);
      }

      function abrirAjuste(bitmap) {
        cropBitmap = bitmap;
        cropNaturalWidth = bitmap.width;
        cropNaturalHeight = bitmap.height;
        cropMinScale = Math.max(CROP_WIDTH / cropNaturalWidth, CROP_HEIGHT / cropNaturalHeight);
        cropScale = cropMinScale;
        cropCenterX = cropNaturalWidth / 2;
        cropCenterY = cropNaturalHeight / 2;
        zoomSlider.value = "0";
        ajusteContenedor.hidden = false;
        btnSacarFoto.disabled = true;
        btnElegirGaleria.disabled = true;
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";
        dibujarCrop();
      }

      function cerrarAjuste() {
        cropBitmap?.close();
        cropBitmap = null;
        ajusteContenedor.hidden = true;
        btnSacarFoto.disabled = false;
        btnElegirGaleria.disabled = false;
      }

      zoomSlider.addEventListener("input", () => {
        const t = Number(zoomSlider.value) / 100;
        cropScale = cropMinScale * (1 + (ZOOM_MAX_MULTIPLIER - 1) * t);
        clampCropCenter();
        dibujarCrop();
      });

      cropCanvas.addEventListener("pointerdown", (e) => {
        cropDragging = true;
        cropCanvas.setPointerCapture(e.pointerId);
        cropDragStartX = e.clientX;
        cropDragStartY = e.clientY;
        cropDragStartCenterX = cropCenterX;
        cropDragStartCenterY = cropCenterY;
      });

      cropCanvas.addEventListener("pointermove", (e) => {
        if (!cropDragging) return;
        const rect = cropCanvas.getBoundingClientRect();
        const factor = CROP_WIDTH / rect.width / cropScale; // px en pantalla -> px de la imagen fuente
        cropCenterX = cropDragStartCenterX - (e.clientX - cropDragStartX) * factor;
        cropCenterY = cropDragStartCenterY - (e.clientY - cropDragStartY) * factor;
        clampCropCenter();
        dibujarCrop();
      });

      function terminarDragCrop() {
        cropDragging = false;
      }
      cropCanvas.addEventListener("pointerup", terminarDragCrop);
      cropCanvas.addEventListener("pointercancel", terminarDragCrop);

      btnCancelarAjuste.addEventListener("click", cerrarAjuste);

      btnConfirmarAjuste.addEventListener("click", async () => {
        fotoMensaje.textContent = "Subiendo foto...";
        fotoMensaje.className = "";

        try {
          const blob = await new Promise((resolve, reject) => {
            cropCanvas.toBlob(
              (b) => (b ? resolve(b) : reject(new Error("No se pudo generar el JPEG"))),
              "image/jpeg",
              0.85
            );
          });
          cerrarAjuste();
          const info = await subirACloudinary(blob);
          mostrarFotoOk(info);
        } catch (err) {
          cerrarAjuste();
          mostrarFotoError(err);
        }
      });

      async function subirACloudinary(blob) {
        const formData = new FormData();
        formData.append("file", blob, "foto.jpg");
        formData.append("upload_preset", uploadPreset);

        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (!res.ok) {
          const cuerpo = await res.json().catch(() => ({}));
          throw new Error(cuerpo?.error?.message || `Error HTTP ${res.status}`);
        }

        return res.json();
      }

      function mostrarFotoOk(info) {
        preview.src = info.secure_url;
        preview.hidden = false;
        fotoUrlInput.value = info.secure_url;
        fotoMensaje.textContent = "Foto lista.";
        fotoMensaje.className = "ok";
      }

      function mostrarFotoError(err) {
        fotoMensaje.textContent = "No se pudo procesar la foto: " + (err?.message || String(err));
        fotoMensaje.className = "error";
      }

      const fotoMensaje = document.getElementById("foto-mensaje");
      const btnSacarFoto = document.getElementById("btn-sacar-foto");
      const btnElegirGaleria = document.getElementById("btn-elegir-galeria");
      const inputGaleria = document.getElementById("input-galeria");
      const camaraContenedor = document.getElementById("camara-contenedor");
      const video = document.getElementById("video-preview");
      const btnCapturar = document.getElementById("btn-capturar");
      const btnCancelarCamara = document.getElementById("btn-cancelar-camara");

      let stream = null;

      function esperarVideoListo(videoEl) {
        if (videoEl.videoWidth > 0) return Promise.resolve();
        return new Promise((resolve) => {
          videoEl.addEventListener("loadedmetadata", () => resolve(), { once: true });
        });
      }

      function cerrarCamara() {
        stream?.getTracks().forEach((track) => track.stop());
        stream = null;
        camaraContenedor.hidden = true;
        video.srcObject = null;
        btnSacarFoto.disabled = false;
        btnElegirGaleria.disabled = false;
      }

      btnSacarFoto.addEventListener("click", async () => {
        fotoMensaje.textContent = "";
        fotoMensaje.className = "";

        if (!navigator.mediaDevices?.getUserMedia) {
          fotoMensaje.textContent = "Este navegador no permite usar la cámara acá. Usá 'Elegir de galería'.";
          fotoMensaje.className = "error";
          return;
        }

        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: {
              facingMode: { ideal: "environment" },
              width: { ideal: 1280 },
              height: { ideal: 960 },
            },
            audio: false,
          });
          video.srcObject = stream;
          camaraContenedor.hidden = false;
          btnSacarFoto.disabled = true;
          btnElegirGaleria.disabled = true;
        } catch (err) {
          fotoMensaje.textContent =
            "No se pudo acceder a la cámara: " + (err?.message || String(err)) + ". Usá 'Elegir de galería'.";
          fotoMensaje.className = "error";
        }
      });

      btnCapturar.addEventListener("click", async () => {
        try {
          await esperarVideoListo(video);
          const bitmap = await createImageBitmap(video);
          cerrarCamara(); // ya tenemos el frame: apagamos la camara antes de ajustar/subir
          abrirAjuste(bitmap);
        } catch (err) {
          cerrarCamara();
          mostrarFotoError(err);
        }
      });

      btnCancelarCamara.addEventListener("click", cerrarCamara);
      window.addEventListener("pagehide", () => {
        cerrarCamara();
        cerrarAjuste();
      });

      btnElegirGaleria.addEventListener("click", () => inputGaleria.click());

      inputGaleria.addEventListener("change", async () => {
        const file = inputGaleria.files?.[0];
        inputGaleria.value = "";
        if (!file) return;

        try {
          const bitmap = await createImageBitmap(file);
          abrirAjuste(bitmap);
        } catch (err) {
          mostrarFotoError(err);
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        mensaje.textContent = "";
        mensaje.className = "";

        const editando = editingId !== null;

        if (!editando && !fotoUrlInput.value) {
          mensaje.textContent = "Elegí una foto antes de publicar.";
          mensaje.className = "error";
          return;
        }

        const payload = {
          fotoUrl: fotoUrlInput.value,
          producto: campoProducto.value,
          precio: Number(campoPrecio.value),
          moneda: campoMoneda.value,
          categoria: campoCategoria.value,
          stock: Number(campoStock.value),
        };

        btnPublicar.disabled = true;
        mensaje.textContent = editando ? "Guardando cambios..." : "Publicando...";

        try {
          const res = await fetch(editando ? `/api/products/${editingId}` : "/api/products", {
            method: editando ? "PATCH" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || `Error HTTP ${res.status}`);
          }

          if (editando) {
            location.reload();
            return;
          }

          mensaje.textContent = "Producto publicado.";
          mensaje.className = "ok";
          form.reset();
          preview.hidden = true;
          fotoUrlInput.value = "";
          fotoMensaje.textContent = "";
          fotoMensaje.className = "";
          // form.reset() vuelve moneda/categoría/stock a su valor HTML por
          // defecto (los limpia); en Carga rápida hay que reponerles el
          // valor automático para que la próxima carga funcione igual.
          aplicarModoCarga(modoActual);
        } catch (err) {
          mensaje.textContent = (editando ? "No se pudo guardar: " : "No se pudo publicar: ") + err.message;
          mensaje.className = "error";
        } finally {
          btnPublicar.disabled = false;
        }
      });

      const mensajeLista = document.getElementById("mensaje-lista");

      function mostrarErrorLista(texto) {
        mensajeLista.textContent = texto;
        mensajeLista.className = "error";
      }

      document.querySelectorAll(".product-card").forEach((card) => {
        const id = card.dataset.productId;

        card.querySelector(".btn-editar").addEventListener("click", (e) => {
          const btn = e.currentTarget;
          entrarModoEdicion({
            id: btn.dataset.id,
            producto: btn.dataset.producto,
            precio: btn.dataset.precio,
            categoria: btn.dataset.categoria,
            stock: btn.dataset.stock,
            foto: btn.dataset.foto,
            moneda: btn.dataset.moneda,
          });
        });

        card.querySelector(".btn-toggle-activo").addEventListener("click", async (e) => {
          const btn = e.currentTarget;
          const activoActual = btn.dataset.activo === "true";
          btn.disabled = true;
          try {
            const res = await fetch(`/api/products/${id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ activo: !activoActual }),
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.error || `Error HTTP ${res.status}`);
            }
            location.reload();
          } catch (err) {
            mostrarErrorLista("No se pudo actualizar el estado: " + err.message);
            btn.disabled = false;
          }
        });
      });
    </script>

    <script>
      import {
        planPlacas,
        buildSuggestedText,
        MAX_PRODUCTOS_PUBLICACION,
        type PublicationProduct,
      } from "../lib/publicationPlan";
      import { generarPlaca, ErrorCargaFoto, type Branding } from "../lib/canvasComposer";
      import {
        crearArchivos,
        puedeCompartir,
        puedeCompartirVarios,
        compartirArchivos,
        descargarArchivo,
        copiarTexto,
      } from "../lib/shareImages";
      import { isValidCurrency } from "../lib/currencies";
      import {
        STORE_NAME,
        BRAND_COLOR,
        PUBLICATION_TITLE,
        PUBLICATION_CLOSING,
        PUBLICATION_HASHTAGS,
      } from "../lib/storeConfig";

      const branding: Branding = { storeName: STORE_NAME, brandColor: BRAND_COLOR };

      const contadorSeleccion = document.getElementById("contador-seleccion");
      const btnPreparar = document.getElementById("btn-preparar-publicacion") as HTMLButtonElement | null;
      const btnEliminarSeleccionados = document.getElementById("btn-eliminar-seleccionados") as HTMLButtonElement | null;
      const mensajePublicacion = document.getElementById("mensaje-publicacion");
      const mensajeListaEliminar = document.getElementById("mensaje-lista");
      const checkboxes = document.querySelectorAll<HTMLInputElement>(".chk-publicacion");

      function mostrarMensajePublicacion(texto: string) {
        if (!mensajePublicacion) return;
        mensajePublicacion.textContent = texto;
        mensajePublicacion.className = "aviso";
        setTimeout(() => {
          mensajePublicacion.textContent = "";
          mensajePublicacion.className = "";
        }, 4000);
      }

      function actualizarBarra() {
        const seleccionados = document.querySelectorAll(".chk-publicacion:checked").length;
        if (contadorSeleccion) {
          contadorSeleccion.textContent = `${seleccionados} seleccionado${seleccionados === 1 ? "" : "s"}`;
        }
        if (btnPreparar) btnPreparar.disabled = seleccionados === 0;
        if (btnEliminarSeleccionados) btnEliminarSeleccionados.disabled = seleccionados === 0;
      }

      checkboxes.forEach((chk) => {
        chk.addEventListener("change", () => {
          const seleccionados = document.querySelectorAll(".chk-publicacion:checked").length;
          if (seleccionados > MAX_PRODUCTOS_PUBLICACION) {
            chk.checked = false;
            mostrarMensajePublicacion(`Podés preparar hasta ${MAX_PRODUCTOS_PUBLICACION} productos por publicación.`);
          }
          actualizarBarra();
        });
      });

      const btnSeleccionarTodos = document.getElementById("btn-seleccionar-todos") as HTMLButtonElement | null;
      const btnDeseleccionarTodos = document.getElementById("btn-deseleccionar-todos") as HTMLButtonElement | null;

      btnSeleccionarTodos?.addEventListener("click", () => {
        const excede = checkboxes.length > MAX_PRODUCTOS_PUBLICACION;
        checkboxes.forEach((chk, indice) => {
          chk.checked = indice < MAX_PRODUCTOS_PUBLICACION;
        });
        if (excede) {
          mostrarMensajePublicacion(`Podés preparar hasta ${MAX_PRODUCTOS_PUBLICACION} productos por publicación.`);
        }
        actualizarBarra();
      });

      btnDeseleccionarTodos?.addEventListener("click", () => {
        checkboxes.forEach((chk) => {
          chk.checked = false;
        });
        actualizarBarra();
      });

      btnEliminarSeleccionados?.addEventListener("click", async () => {
        const idsSeleccionados = Array.from(
          document.querySelectorAll<HTMLInputElement>(".chk-publicacion:checked")
        )
          .map((chk) => chk.dataset.id)
          .filter((id): id is string => Boolean(id));

        if (idsSeleccionados.length === 0) return;

        const cantidad = idsSeleccionados.length;
        const confirmado = confirm(
          `¿Eliminar definitivamente ${cantidad} producto${cantidad === 1 ? "" : "s"}? Esta acción no se puede deshacer.`
        );
        if (!confirmado) return;

        btnEliminarSeleccionados.disabled = true;

        try {
          const res = await fetch("/api/products", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids: idsSeleccionados }),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || `Error HTTP ${res.status}`);
          }

          if (mensajeListaEliminar) {
            mensajeListaEliminar.textContent = `${cantidad} producto${cantidad === 1 ? "" : "s"} eliminado${cantidad === 1 ? "" : "s"}.`;
            mensajeListaEliminar.className = "ok";
          }
          setTimeout(() => location.reload(), 700);
        } catch (err) {
          if (mensajeListaEliminar) {
            mensajeListaEliminar.textContent =
              "No se pudo eliminar: " + (err instanceof Error ? err.message : "Error desconocido");
            mensajeListaEliminar.className = "error";
          }
          btnEliminarSeleccionados.disabled = false;
        }
      });

      actualizarBarra();

      function leerProductosSeleccionados(): PublicationProduct[] {
        const seleccionados: PublicationProduct[] = [];

        document.querySelectorAll<HTMLInputElement>(".chk-publicacion:checked").forEach((chk) => {
          const card = chk.closest<HTMLElement>(".product-card");
          const btnEditar = card?.querySelector<HTMLButtonElement>(".btn-editar");
          if (!btnEditar) return;

          const { id, producto, precio, foto, moneda } = btnEditar.dataset;
          if (!id || !producto || !precio || !foto || !isValidCurrency(moneda)) return;

          seleccionados.push({ id, producto, precio: Number(precio), moneda, fotoUrl: foto });
        });

        return seleccionados;
      }

      // --- Modal de publicación ---
      const pubOverlay = document.getElementById("pub-overlay");
      const pubModal = document.getElementById("pub-modal");
      const pubCerrar = document.getElementById("pub-cerrar");
      const pubEstado = document.getElementById("pub-estado");
      const pubTabs = document.getElementById("pub-tabs");
      const pubPreviewImg = document.getElementById("pub-preview-img") as HTMLImageElement | null;
      const pubTexto = document.getElementById("pub-texto") as HTMLTextAreaElement | null;
      const pubCopiarTexto = document.getElementById("pub-copiar-texto") as HTMLButtonElement | null;
      const pubAccionesCompartir = document.getElementById("pub-acciones-compartir");

      let objectUrls: string[] = [];

      function revocarObjectUrls() {
        objectUrls.forEach((url) => URL.revokeObjectURL(url));
        objectUrls = [];
      }

      function mostrarPlaca(indice: number) {
        if (pubPreviewImg) {
          pubPreviewImg.src = objectUrls[indice];
          pubPreviewImg.hidden = false;
        }
        pubTabs?.querySelectorAll<HTMLButtonElement>(".pub-tab").forEach((tab, i) => {
          tab.classList.toggle("activa", i === indice);
        });
      }

      function abrirModal() {
        pubOverlay?.removeAttribute("hidden");
        pubModal?.classList.add("abierto");
        pubModal?.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function cerrarModal() {
        pubOverlay?.setAttribute("hidden", "");
        pubModal?.classList.remove("abierto");
        pubModal?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        revocarObjectUrls();
        if (pubPreviewImg) {
          pubPreviewImg.hidden = true;
          pubPreviewImg.removeAttribute("src");
        }
        if (pubAccionesCompartir) pubAccionesCompartir.innerHTML = "";
      }

      pubCerrar?.addEventListener("click", cerrarModal);
      pubOverlay?.addEventListener("click", cerrarModal);

      function renderAccionesCompartir(files: File[], texto: string) {
        if (!pubAccionesCompartir) return;
        pubAccionesCompartir.innerHTML = "";

        function crearBoton(etiqueta: string, primario: boolean, onClick: () => void): HTMLButtonElement {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = etiqueta;
          btn.className = `pub-btn ${primario ? "pub-btn-primario" : "pub-btn-secundario"}`;
          btn.addEventListener("click", onClick);
          return btn;
        }

        if (files.length === 1) {
          if (puedeCompartir()) {
            pubAccionesCompartir.appendChild(
              crearBoton("Compartir", true, async () => {
                const resultado = await compartirArchivos(files, texto, STORE_NAME);
                if (resultado === "error") {
                  mostrarMensajePublicacion("No se pudo compartir. Probá 'Guardar imagen'.");
                }
              })
            );
          } else {
            pubAccionesCompartir.appendChild(
              crearBoton("Guardar imagen", true, () => descargarArchivo(files[0]))
            );
          }
          return;
        }

        // Dos placas.
        if (puedeCompartir() && puedeCompartirVarios(files)) {
          pubAccionesCompartir.appendChild(
            crearBoton("Compartir (2 imágenes)", true, async () => {
              const resultado = await compartirArchivos(files, texto, STORE_NAME);
              if (resultado === "error") {
                mostrarMensajePublicacion("No se pudo compartir. Probá compartir cada placa por separado.");
              }
            })
          );
        } else if (puedeCompartir()) {
          files.forEach((file, i) => {
            pubAccionesCompartir?.appendChild(
              crearBoton(`Compartir placa ${i + 1}`, i === 0, async () => {
                const resultado = await compartirArchivos([file], texto, STORE_NAME);
                if (resultado === "error") {
                  mostrarMensajePublicacion(`No se pudo compartir la placa ${i + 1}.`);
                }
              })
            );
          });
        } else {
          files.forEach((file, i) => {
            pubAccionesCompartir?.appendChild(
              crearBoton(`Guardar placa ${i + 1}`, i === 0, () => descargarArchivo(file))
            );
          });
        }
      }

      pubCopiarTexto?.addEventListener("click", async () => {
        if (!pubTexto || !pubCopiarTexto) return;
        const copiado = await copiarTexto(pubTexto.value);
        const textoOriginal = pubCopiarTexto.textContent;
        pubCopiarTexto.textContent = copiado ? "¡Copiado!" : "No se pudo copiar";
        setTimeout(() => {
          if (pubCopiarTexto) pubCopiarTexto.textContent = textoOriginal;
        }, 1800);
      });

      function renderAccionesError(err: unknown) {
        if (!pubAccionesCompartir) return;
        pubAccionesCompartir.innerHTML = "";

        function crearBoton(etiqueta: string, primario: boolean, onClick: () => void): HTMLButtonElement {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = etiqueta;
          btn.className = `pub-btn ${primario ? "pub-btn-primario" : "pub-btn-secundario"}`;
          btn.addEventListener("click", onClick);
          return btn;
        }

        if (err instanceof ErrorCargaFoto) {
          pubAccionesCompartir.appendChild(
            crearBoton(`Desmarcar "${err.nombreProducto}" y reintentar`, true, () => {
              const chk = document.querySelector<HTMLInputElement>(
                `.chk-publicacion[data-id="${err.productoId}"]`
              );
              if (chk) chk.checked = false;
              actualizarBarra();
              prepararPublicacion();
            })
          );
        }

        pubAccionesCompartir.appendChild(
          crearBoton("Volver a la selección", !(err instanceof ErrorCargaFoto), cerrarModal)
        );
      }

      async function prepararPublicacion() {
        const productos = leerProductosSeleccionados();
        if (productos.length === 0) {
          cerrarModal();
          mostrarMensajePublicacion("No quedan productos seleccionados.");
          return;
        }

        revocarObjectUrls();
        if (pubTabs) pubTabs.hidden = true;
        if (pubPreviewImg) pubPreviewImg.hidden = true;
        if (pubAccionesCompartir) pubAccionesCompartir.innerHTML = "";
        if (pubEstado) {
          pubEstado.hidden = false;
          pubEstado.textContent = "Generando…";
        }
        if (pubTexto) {
          pubTexto.value = buildSuggestedText(productos, {
            titulo: PUBLICATION_TITLE,
            fraseFinal: PUBLICATION_CLOSING,
            hashtags: PUBLICATION_HASHTAGS,
          });
        }

        abrirModal();

        const grupos = planPlacas(productos);

        try {
          const blobs: Blob[] = [];
          // Secuencial (no Promise.all): evita mantener varios canvases/fotos
          // decodificadas en memoria al mismo tiempo (importa en gama media).
          for (const grupo of grupos) {
            blobs.push(await generarPlaca(grupo, branding, PUBLICATION_TITLE));
          }

          objectUrls = blobs.map((blob) => URL.createObjectURL(blob));

          if (pubEstado) pubEstado.hidden = true;
          if (grupos.length > 1 && pubTabs) pubTabs.hidden = false;
          mostrarPlaca(0);

          const archivos = crearArchivos(blobs);
          renderAccionesCompartir(archivos, pubTexto?.value ?? "");
        } catch (err) {
          if (pubEstado) {
            pubEstado.hidden = false;
            pubEstado.textContent =
              "No se pudo generar la publicación: " + (err instanceof Error ? err.message : String(err));
          }
          renderAccionesError(err);
        }
      }

      btnPreparar?.addEventListener("click", prepararPublicacion);

      pubTabs?.querySelectorAll<HTMLButtonElement>(".pub-tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          const indice = Number(tab.dataset.placa ?? "0");
          if (objectUrls[indice]) mostrarPlaca(indice);
        });
      });
    </script>
  </body>
</html>
