---
// Pagina TEMPORAL de diagnostico. No forma parte del flujo real, no toca
// /admin, no esta enlazada desde ningun lado. Borrar cuando termine la prueba.
const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "srxrmckc";
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "mute-products";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test temporal - getUserMedia</title>
  </head>
  <body>
    <h1>Prueba aislada: cámara en vivo (getUserMedia)</h1>
    <p>No forma parte del catálogo ni de /admin. Sube directo a Cloudinary con el preset unsigned actual.</p>

    <section>
      <h2>A — Cámara en vivo</h2>
      <div class="botones">
        <button type="button" id="btn-abrir-camara">Abrir cámara</button>
        <button type="button" id="btn-capturar" disabled>Capturar</button>
        <button type="button" id="btn-cerrar-camara" disabled>Cerrar cámara</button>
      </div>
      <video id="video-preview" playsinline autoplay muted hidden></video>
      <p id="video-info"></p>
      <img id="preview-camara" alt="" hidden />
      <p id="mensaje-camara" role="status"></p>
    </section>

    <section>
      <h2>B — Galería / Archivos (mismo resize)</h2>
      <input type="file" id="input-galeria" accept="image/*" />
      <img id="preview-galeria" alt="" hidden />
      <p id="mensaje-galeria" role="status"></p>
    </section>

    <style>
      body {
        font-family: system-ui, sans-serif;
        padding: 1rem;
        max-width: 480px;
        margin: 0 auto;
      }
      section {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
      }
      .botones {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
      }
      button {
        font-size: 1rem;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        border: 1px solid #ccc;
      }
      button:disabled {
        opacity: 0.5;
      }
      video,
      img {
        width: 100%;
        max-width: 320px;
        border-radius: 8px;
        background: #222;
        display: block;
        margin: 0.5rem 0;
      }
      p {
        white-space: pre-wrap;
        word-break: break-all;
      }
      .error {
        color: #a11f1f;
      }
      .ok {
        color: #1a7a3c;
      }
    </style>

    <script define:vars={{ cloudName, uploadPreset }} is:inline>
      // --- Helper compartido: dibuja una fuente (video o ImageBitmap) en un
      // canvas escalado (sin recortar ni agrandar) y devuelve un Blob JPEG. ---
      function dibujarEnCanvas(source, srcWidth, srcHeight, maxWidth, maxHeight, calidad) {
        const escala = Math.min(1, maxWidth / srcWidth, maxHeight / srcHeight);
        const width = Math.round(srcWidth * escala);
        const height = Math.round(srcHeight * escala);

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        canvas.getContext("2d").drawImage(source, 0, 0, width, height);

        return new Promise((resolve, reject) => {
          canvas.toBlob(
            (blob) => (blob ? resolve({ blob, width, height }) : reject(new Error("No se pudo generar el JPEG"))),
            "image/jpeg",
            calidad
          );
        });
      }

      async function archivoAResizedBlob(file, maxWidth, maxHeight, calidad) {
        const bitmap = await createImageBitmap(file);
        try {
          return await dibujarEnCanvas(bitmap, bitmap.width, bitmap.height, maxWidth, maxHeight, calidad);
        } finally {
          bitmap.close();
        }
      }

      async function subirACloudinary(blob) {
        const formData = new FormData();
        formData.append("file", blob, "foto.jpg");
        formData.append("upload_preset", uploadPreset);

        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (!res.ok) {
          const cuerpo = await res.json().catch(() => ({}));
          throw new Error(cuerpo?.error?.message || `HTTP ${res.status}`);
        }

        return res.json();
      }

      function mostrarResultado(mensajeEl, previewEl, blob, info) {
        previewEl.src = URL.createObjectURL(blob);
        previewEl.hidden = false;
        mensajeEl.className = "ok";
        mensajeEl.textContent =
          "OK\n" +
          "bytes subidos: " + blob.size + " (" + (blob.size / 1024).toFixed(0) + " KB)\n" +
          "dimensiones: " + info.width + " x " + info.height + "\n" +
          "url Cloudinary: " + info.secure_url +
          "\nbytes en Cloudinary: " + info.bytes;
      }

      function mostrarError(mensajeEl, err) {
        mensajeEl.className = "error";
        mensajeEl.textContent = "ERROR: " + (err?.message || String(err));
      }

      // --- A: Camara en vivo ---
      const video = document.getElementById("video-preview");
      const videoInfo = document.getElementById("video-info");
      const btnAbrir = document.getElementById("btn-abrir-camara");
      const btnCapturar = document.getElementById("btn-capturar");
      const btnCerrar = document.getElementById("btn-cerrar-camara");
      const previewCamara = document.getElementById("preview-camara");
      const mensajeCamara = document.getElementById("mensaje-camara");

      let stream = null;

      function cerrarCamara() {
        stream?.getTracks().forEach((track) => track.stop());
        stream = null;
        video.hidden = true;
        video.srcObject = null;
        btnCapturar.disabled = true;
        btnCerrar.disabled = true;
        btnAbrir.disabled = false;
      }

      btnAbrir.addEventListener("click", async () => {
        mensajeCamara.textContent = "";
        mensajeCamara.className = "";
        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: {
              facingMode: { ideal: "environment" },
              width: { ideal: 1280 },
              height: { ideal: 960 },
            },
            audio: false,
          });
          video.srcObject = stream;
          video.hidden = false;
          btnAbrir.disabled = true;
          btnCapturar.disabled = false;
          btnCerrar.disabled = false;
          videoInfo.textContent = "Cargando resolución negociada...";
          video.addEventListener(
            "loadedmetadata",
            () => {
              videoInfo.textContent = "Resolución negociada por la cámara: " + video.videoWidth + " x " + video.videoHeight;
            },
            { once: true }
          );
        } catch (err) {
          mostrarError(mensajeCamara, err);
        }
      });

      btnCapturar.addEventListener("click", async () => {
        mensajeCamara.textContent = "Capturando y subiendo...";
        mensajeCamara.className = "";
        try {
          const { blob, width, height } = await dibujarEnCanvas(
            video,
            video.videoWidth,
            video.videoHeight,
            1280,
            960,
            0.85
          );
          const info = await subirACloudinary(blob);
          mostrarResultado(mensajeCamara, previewCamara, blob, { ...info, width, height });
        } catch (err) {
          mostrarError(mensajeCamara, err);
        }
      });

      btnCerrar.addEventListener("click", cerrarCamara);
      window.addEventListener("pagehide", cerrarCamara);

      // --- B: Galeria / Archivos, mismo resize ---
      const inputGaleria = document.getElementById("input-galeria");
      const previewGaleria = document.getElementById("preview-galeria");
      const mensajeGaleria = document.getElementById("mensaje-galeria");

      inputGaleria.addEventListener("change", async () => {
        const file = inputGaleria.files?.[0];
        if (!file) return;

        mensajeGaleria.textContent = "Procesando y subiendo...";
        mensajeGaleria.className = "";
        try {
          const { blob, width, height } = await archivoAResizedBlob(file, 1280, 960, 0.85);
          const info = await subirACloudinary(blob);
          mostrarResultado(mensajeGaleria, previewGaleria, blob, { ...info, width, height });
        } catch (err) {
          mostrarError(mensajeGaleria, err);
        }
      });
    </script>
  </body>
</html>
