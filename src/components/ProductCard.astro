---
import type { CatalogProduct } from "../lib/sheets";

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;

const estadoClase: Record<string, string> = {
  "Agotado": "estado-agotado",
  "Últimas unidades": "estado-poco",
  "Disponible": "estado-ok",
};

const puedeAgregar = product.estado !== "Agotado";
---

<article
  class="card"
  data-nombre={product.producto.toLowerCase()}
  data-categoria={product.categoria}
>
  <div class="foto">
    <img src={product.fotoUrl} alt={product.producto} loading="lazy" />
    <span class={`estado ${estadoClase[product.estado]}`}>{product.estado}</span>
  </div>
  <div class="info">
    <p class="categoria">{product.categoria}</p>
    <h3>{product.producto}</h3>
    <div class="fila-inferior">
      <p class="precio">${product.precio.toLocaleString("es-AR")}</p>
      {puedeAgregar && (
        <button
          type="button"
          class="btn-agregar"
          aria-label={`Agregar ${product.producto}`}
          data-id={product.id}
          data-nombre={product.producto}
          data-precio={product.precio}
          data-foto={product.fotoUrl}
        >
          Agregar
        </button>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .foto {
    position: relative;
  }
  .foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    background: #f2f2f2;
  }
  .estado {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.01em;
    backdrop-filter: blur(2px);
  }
  .estado-ok {
    background: rgba(220, 245, 227, 0.95);
    color: #1a7a3c;
  }
  .estado-poco {
    background: rgba(255, 243, 205, 0.95);
    color: #8a6100;
  }
  .estado-agotado {
    background: rgba(245, 220, 220, 0.95);
    color: #a11f1f;
  }
  .info {
    padding: 0.65rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }
  .categoria {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #888;
  }
  .info h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .fila-inferior {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .precio {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .btn-agregar {
    border: none;
    background: var(--brand-color, #1a7a3c);
    color: #fff;
    font-weight: 600;
    font-size: 0.82rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
</style>
